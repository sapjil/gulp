<meta charset="UTF-8" />
{# <!-- Global Metadata --> #}
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<title>
	{%- if title -%}
		{{title}} | {{site_data.title}}
	{%- else -%}
		{{site_data.title}}
	{%- endif -%}
</title>
<base href="{{site_data.root}}" />
<!-- Primary Meta Tags -->
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="description" content="{%- if description -%}{{description}}{% else %}{{site_data.description}}{% endif %}" />
<meta name="keywords" content="{{site_data.keyword}}{%- if keyword -%}, {{keyword}}{%- endif -%}" />
<meta name="robots" content="index, follow" />
<!-- Open Graph / Facebook -->
<meta property="og:type" content="website">
<meta property="og:url" content="{{site_data.siteurl}}">
<meta property="og:title" content="{{site_data.title}}">
<meta property="og:description" content="{%- if description -%}{{description}}{% else %}{{site_data.description}}{%- endif -%}">
<meta property="og:image" content="{% if optimage %}{{optimage}}{% else %}{{site_data.optimage}}{% endif %}">
<!-- Twitter -->
<meta property="twitter:card" content="{{site_data.twitterCard}}">
<meta property="twitter:url" content="{{site_data.siteurl}}">
<meta property="twitter:title" content="{{site_data.title}}">
<meta property="twitter:description" content="{%- if description -%}{{description}}{% else %}{{site_data.description}}{%- endif -%}">
<meta property="twitter:image" content="{% if optimage %}{{optimage}}{% else %}{{site_data.optimage}}{% endif %}">
<!-- Canonical URL -->
<link rel="canonical" href="{{site_data.siteurl}}" />
<link rel="stylesheet" href="/common/css/style.css" />
{# <link rel="stylesheet" href="/common/js/lib/swiper-bundle.css" /> #}
<link rel="preload" href="/common/js/lib/swiper-bundle.css" as="style" onload="this.onload=null;this.rel='stylesheet'" />
<script src="/common/js/lib/swiper-bundle.min.js" defer></script>
<script src="/common/js/all.js" defer></script>
